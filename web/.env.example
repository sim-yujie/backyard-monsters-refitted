# Base URL of the Backyard Monsters Refitted server.
#
# Leave EMPTY for local development: requests then go to the Vite dev server on
# the same origin, which proxies every game route to http://localhost:3001
# (see vite.config.ts). Same-origin also means no CORS preflight in dev.
#
# Set it to an absolute origin (no trailing slash) to talk to a remote server,
# e.g. VITE_SERVER_URL=https://api.example.com
VITE_SERVER_URL=

# Where the dev proxy forwards game routes. Only used by vite.config.ts.
VITE_PROXY_TARGET=http://localhost:3001

# Client build string sent as the :apiVersion path segment on /api/... routes.
# The server only enforces a match when USE_VERSION_MANAGEMENT=enabled; with it
# disabled (the default in dev) any value is accepted.
VITE_API_VERSION=v1.6.1-beta

# Cloudflare Turnstile site key for the sign-up form's bot check (issue #213).
# The server must have the matching TURNSTILE_SECRET_KEY. Leave EMPTY to show
# no check (local dev; the server skips it too when it has no secret). The
# widget's script is loaded only when the sign-up form opens. Cloudflare's
# test site keys: 1x00000000000000000000AA always passes,
# 2x00000000000000000000AB always fails.
TURNSTILE_SITE_KEY=

# Where the Terms and Privacy Policy links on the sign-up form go. Default to
# the placeholder pages this client ships (terms.html, privacy.html); set them
# to the real documents' addresses once they exist.
VITE_TERMS_URL=/terms
VITE_PRIVACY_URL=/privacy
