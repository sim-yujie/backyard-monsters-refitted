{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "VITE_SERVER_URL=https://api.EXAMPLE.com npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/assets/:path*", "destination": "https://api.EXAMPLE.com/assets/:path*" },
    { "source": "/gamestage/:path*", "destination": "https://api.EXAMPLE.com/gamestage/:path*" },
    { "source": "/templates/:path*", "destination": "https://api.EXAMPLE.com/templates/:path*" },
    { "source": "/reset-password", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
