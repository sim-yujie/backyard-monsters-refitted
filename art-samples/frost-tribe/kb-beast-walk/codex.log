        sprite = sprite.resize((round(sprite.width * .90), round(sprite.height * .90)), Image.Resampling.LANCZOS)
        sheet.paste(sprite, ((left + right - sprite.width) // 2, row * 256 + 219 - sprite.height), sprite)
        print(row + 1, col + 1, sprite.size)
