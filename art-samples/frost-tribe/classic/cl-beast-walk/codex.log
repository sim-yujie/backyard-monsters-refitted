from PIL import Image
import sys

size = (1536, 1024)
key = (255, 0, 255)
def is_background(pixel):
    red, green, blue = pixel
    return red >= 228 and green <= 31 and blue >= 225

def bounds(image):
    for row in range(4):
        for column in range(5):
            x0, x1 = (column * size[0]) // 5, ((column + 1) * size[0]) // 5
            y0, y1 = row * 256, (row + 1) * 256
            cell = image.crop((x0, y0, x1, y1))
            mask = Image.new('L', cell.size)
            mask.putdata([0 if is_background(pixel) else 255 for pixel in cell.get_flattened_data()])
            box = mask.getbbox()
            assert box and box[0] > 0 and box[1] > 0 and box[2] < cell.width and box[3] < cell.height, (row, column, box)
            yield box

generated = Image.open(sys.argv[1]).convert('RGB')
source = Image.open('modern-sheet.png').convert('RGB')
assert generated.size == source.size == size
result = Image.new('RGB', size)
result.putdata([key if is_background(pixel) else pixel for pixel in generated.get_flattened_data()])
changes = [tuple(after - before for before, after in zip(old, new)) for old, new in zip(bounds(source), bounds(result))]
print('Per-cell bounds deltas (left, top, right, bottom):', changes)
result.save('sheet.png')
with Image.open('sheet.png') as saved:
    saved.verify()
