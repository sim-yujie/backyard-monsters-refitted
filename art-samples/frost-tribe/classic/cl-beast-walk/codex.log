        size = (target[2]-target[0], target[3]-target[1])
        tile = tile.crop(box)
        mask = mask.crop(box)
        if tile.size "'!= size:
            tile.putalpha(mask)
            tile = tile.resize(size, Image.Resampling.BICUBIC).convert('"'RGB')
            mask = mask.resize(size, Image.Resampling.NEAREST)
        result.paste(tile, (x+target[0], y+target[1]), mask)
result.save('sheet.png')
with Image.open('sheet.png') as saved:
    assert saved.size == (1536, 1024)
    saved.verify()
print('Verified 20 sprites inside their cells and saved sheet.png.')
