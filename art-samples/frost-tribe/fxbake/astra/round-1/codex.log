/bin/bash -lc "python - <<'PY'
import json
from pathlib import Path
m=json.loads(Path('motion.json').read_text())
c=json.loads(Path('cells.json').read_text())
known=set(c['sheets'][0]['cells'])
used=set()
for ability, data in m.items():
 for hook, pieces in data.items():
  if not isinstance(pieces,list): continue
  for p in pieces:
   names=p.get('flipbook',[p.get('cell')]); used.update(names)
   assert set(names)<=known
   assert 'anchor' in p
   held='loop_ms' in p
   assert p.get('loop_ms',p.get('life_ms',0))>0
   if not held:
    assert 'start_ms' in p
    end=p['start_ms']+p['life_ms']+(p.get('count',1)-1)*p.get('stagger_ms',0)
    if ability=='frostAura': assert end<600
    if ability=='iceShards': assert end+(200 if hook=='impact' else 0)<600
    if ability=='blizzardStomp': assert p['start_ms']>=-600 and end<1400
   if p.get('fly_to'): assert p['life_ms']==200 and p['fly_to']=='target'
   for field in ['start_ms','life_ms','loop_ms','fade_in_ms','stagger_ms']:
    if field in p: assert p[field]%12.5==0,(ability,field,p[field])
assert used==known,(used,known)
assert c['sheets'][0]['cells']==c['sheets'][1]['cells']
assert all(len(s['cells'])==s['columns']*s['rows']==16 for s in c['sheets'])
print('PASS: JSON, 16/16 cells used in both looks, timings, anchors, flight duration, tick alignment')
