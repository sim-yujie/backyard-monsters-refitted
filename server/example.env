# Visit our Wiki to get more information about our environment variables.
# Wiki: https://github.com/bym-refitted/backyard-monsters-refitted/wiki/Server-&-Database-Setup

# Base URLs
BASE_URL=http://localhost
CDN_URL=  # Required when USE_VERSION_MANAGEMENT is enabled

# Server
# SECRET_KEY signs and checks login tokens on every server; the server will
# not start without one. ENV is local or production. A server that looks like
# production (ENV=production, or NODE_ENV=production as PM2 sets) refuses to
# start unless ENV=production, SECRET_KEY is at least 32 characters (e.g.
# openssl rand -hex 32) and DB_PASSWORD is not the example dev12345
# (server/src/config/StartupSafety.ts, issue #319).
PORT=3001
SECRET_KEY=
SESSION_LIFETIME=30d
ENV=local

# Who may tell the server a player's real IP (server/src/config/ProxyConfig.ts,
# issue #214). Rate limits and logs use the CF-Connecting-IP header only when
# the connection comes from one of these; otherwise the connecting address.
# Comma-separated: cloudflare (Cloudflare's published ranges), IP addresses or
# ranges such as 172.16.0.0/12, or none. Unset means cloudflare. If something
# sits between Cloudflare and the server (nginx, the Docker gateway), add its
# address, e.g. cloudflare,172.17.0.1 - otherwise every player shares one IP
# and one rate limit.
TRUSTED_PROXIES=cloudflare

# Docker-specific ports (these map to your host machine)
API_PORT=3001

# Uncomment if you have a local PostgreSQL install conflicting on port 5432
# DB_HOST_PORT=5433

# Database
DB_NAME='bym'
DB_HOST='localhost'
DB_PORT=5432
DB_USER='postgres'
DB_PASSWORD='dev12345'

# pgAdmin
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=8080

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# Chat WebSocket server
CHAT_WS_PORT=3010
CHAT_WS_HOST=localhost:3010

# Ports the Flash socket policy authorises (comma-separated, or a range).
# Only set this where several environments share a host: whichever process
# binds port 843 answers for all of them, so it must list every chat port.
# Defaults to CHAT_WS_PORT.
# CHAT_POLICY_PORTS=3010,3011

# Switches
USE_VERSION_MANAGEMENT='disabled'

# Local development only (server/src/config/GameConfig.ts, issue #217). true
# offers the maxed sandbox yard (about 575 buildings, maxed resources) to new
# accounts: the web sign-up form shows an unticked "Start with the test yard
# (dev)" box, and only an account that ticks it gets the sandbox yard on its
# first /base/load. Everyone else gets the normal new-player start. The seed
# scripts (db:seed:*) still give every seeded account the sandbox yard while it
# is on. Ignored when ENV=production.
DEV_SANDBOX=false

# Economy save audit (docs/design/economy-save-validation.md): off disables it,
# log records violations only, reject refuses saves that don't add up. It only
# ever sees owner saves, which OWNER_SAVE_MODE=refuse turns away first; reject
# is the default (issue #43).
ECONOMY_SAVE_VALIDATION=reject

# Attack save audit (docs/design/server-combat.md): resource bombs are always
# charged and the server's replay of the battle is always what is written.
# off checks nothing; log records a bomb the attacker could not have fired, or
# a save the replay does not bear out; reject (the default) refuses the save.
# Set log to stop refusing if honest players are ever turned away.
COMBAT_SAVE_VALIDATION=reject

# Owner saves of a main yard (docs/design/yard-buildings.md T1): refuse answers
# an owner /base/save of the main yard with 409 ownerSaveRetired, allow applies
# it as before (debugging only). Attack and outpost saves are never affected.
OWNER_SAVE_MODE=refuse

# Achievements (docs/design/achievements.md, issue #204): on (the default)
# credits each unlock's Shiny and writes its bell line; off still counts and
# unlocks, and pays everything earned so far once it is turned back on.
ACHIEVEMENT_REWARDS=on

# The minute sweep that lands attacks left without a save (issue #138). off
# leaves it to another server on the same database, such as a second dev server.
ATTACK_FINALISER_SWEEP=on

# Map Room 1 bot neighbours (docs/design/bot-neighbours.md, issue #233). All
# off unless set to on. BOTS_FILL: bots fill the neighbour places real players
# leave empty. BOTS_BRAIN: the bot sweep (grow, repair, rebalance). BOTS_REVENGE:
# an attacked bot may attack back; off also cancels pending revenge.
# BOTS_TOTAL is how many bots to keep, BOTS_DAYS_PER_LEVEL their growth pace.
BOTS_FILL=off
BOTS_BRAIN=off
BOTS_REVENGE=off
BOTS_TOTAL=500
BOTS_DAYS_PER_LEVEL=3

# Website
WEB_URL=https://bymrefitted.com

# Discord
DISCORD_TOKEN=

# Discord gate (server/src/config/AccountConfig.ts). true: on ENV=production a
# login is refused until the account is verified on the Discord server, and
# attacks and Map Room moves need a Discord account at least a week old (the
# old behaviour). Unset or anything else: no Discord needed, so players who
# sign up on the web client can play. Never enforced on a local server.
REQUIRE_DISCORD_VERIFICATION=

# Sign-up bot check, Cloudflare Turnstile (server/src/services/auth/turnstile.ts).
# The secret key of the widget whose site key the web client is built with
# (TURNSTILE_SITE_KEY in web/.env). Leave empty to skip the check (local dev;
# the server logs that it is off). Cloudflare's test secrets:
# 1x0000000000000000000000000000000AA always passes,
# 2x0000000000000000000000000000000AA always fails.
TURNSTILE_SECRET_KEY=

# Mail server
SMTP_HOST=127.0.0.1
SMTP_PORT=    
SMTP_USER=
SMTP_PASSWORD=

# Who the password-reset email comes from. Its domain must be one the mail
# service has verified. Unset means Backyard Monsters Refitted <info@bymrefitted.com>.
# A production server refuses to start without SMTP_HOST, SMTP_PORT, SMTP_USER,
# SMTP_PASSWORD, WEB_URL and TURNSTILE_SECRET_KEY (StartupSafety.ts).
MAIL_FROM=

# The mail server's TLS certificate is checked (issue #215), so SMTP_HOST must
# be the name on its certificate (e.g. smtp.resend.com), not a bare IP. true
# accepts any certificate, for a local test relay only; ignored on production.
SMTP_INSECURE_TLS=false

# Mail is always encrypted (issue #320): TLS from the start on production and
# on port 465, otherwise STARTTLS is required and mail is not sent without it.
# true allows plain text, for a local test mail server with no TLS (Mailpit,
# MailHog); ignored on production.
SMTP_ALLOW_PLAINTEXT=false
