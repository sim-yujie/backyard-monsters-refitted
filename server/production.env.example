# Settings for the live game server (docs/deploy.md).
#
# Copy this file to production.env on the server, in this same folder, and
# fill in every value marked FILL IN. production.env holds passwords: it is
# never committed to git (.gitignore) and never copied into the Docker image.
#
# docker-compose.prod.yml reads this file. A few settings are not here because
# the compose file sets them itself (ENV=production, the database and Redis
# addresses, the chat address, TRUSTED_PROXIES).
#
# The server refuses to start while any required value below is missing or
# still a placeholder (server/src/config/StartupSafety.ts).

# ── Addresses ───────────────────────────────────────────────────────────────
# The game server's address, without https://. Point this name at the
# server's IP address in your DNS (an A record). Caddy gets the HTTPS
# certificate for it by itself. Must match the address in web/vercel.json.
API_DOMAIN=api.EXAMPLE.com

# The address players open the game on (the Vercel site), without https://.
# Password-reset emails link here.
WEB_DOMAIN=play.EXAMPLE.com

# Your email address. Let's Encrypt (the free HTTPS certificates) writes to it
# only if a certificate has a problem.
ACME_EMAIL=FILL IN

# ── Secrets ─────────────────────────────────────────────────────────────────
# Signs every player's login. At least 32 random characters; make one with:
#   openssl rand -hex 32
# Changing it later logs everyone out.
SECRET_KEY=FILL IN

# How long a login lasts before the player must sign in again.
SESSION_LIFETIME=30d

# ── Database ────────────────────────────────────────────────────────────────
# The database is created on first start with this name, user and password.
# Make the password long and random (openssl rand -hex 24). Do not change any
# of the three once the game has data: the database keeps the old ones.
DB_NAME=bym
DB_USER=bym
DB_PASSWORD=FILL IN

# ── Email (password resets) ─────────────────────────────────────────────────
# Resend's SMTP settings (https://resend.com/docs/send-with-smtp). The user is
# the word "resend"; the password is a Resend API key (starts with re_).
# The port must be 465: the server always encrypts mail in production.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=FILL IN

# Who the emails come from. The part after @ must be a domain you verified in
# Resend, or the emails are refused.
MAIL_FROM=Backyard Monsters Refitted <no-reply@EXAMPLE.com>

# ── Bot check on sign-up (Cloudflare Turnstile) ─────────────────────────────
# The SECRET key of your Turnstile widget. The matching SITE key goes in the
# Vercel project as TURNSTILE_SITE_KEY. The server refuses to start without it.
TURNSTILE_SECRET_KEY=FILL IN

# ── Discord ─────────────────────────────────────────────────────────────────
# Leave REQUIRE_DISCORD_VERIFICATION empty so players who sign up on the web
# can play without Discord. DISCORD_TOKEN is only needed for the Discord gate.
REQUIRE_DISCORD_VERIFICATION=
DISCORD_TOKEN=

# ── Game switches (example.env explains each) ───────────────────────────────
ECONOMY_SAVE_VALIDATION=reject
COMBAT_SAVE_VALIDATION=reject
OWNER_SAVE_MODE=refuse
ACHIEVEMENT_REWARDS=on
ATTACK_FINALISER_SWEEP=on

# Map Room 1 bot neighbours (docs/design/bot-neighbours.md): on fills empty
# neighbour places with bots, which a new game with few players may want.
BOTS_FILL=off
BOTS_BRAIN=off
BOTS_REVENGE=off
BOTS_TOTAL=500
BOTS_DAYS_PER_LEVEL=3

# ── Client version check (off) ──────────────────────────────────────────────
# enabled makes the server reject clients whose version does not match a
# manifest at CDN_URL/versionManifest.json. The web client does not need it.
USE_VERSION_MANAGEMENT=disabled
CDN_URL=

# ── Backups (deploy/backup.sh) ──────────────────────────────────────────────
# The hour (UTC, 0-23) of the daily database backup, and how many days of
# backups to keep in server/backups/.
BACKUP_HOUR=3
KEEP_DAYS=14
