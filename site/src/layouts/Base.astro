---
import "../styles/global.css";
import { SITE } from "../config";

interface Props {
  /** The page's own name; the site name is added after it. Omit on the home page. */
  title?: string;
  description?: string;
  /** Which header link to mark as the current page. */
  current?: "home" | "guides" | "changelog" | "support" | "credits";
  /** A path under public/ for the share preview; defaults to the site card. */
  ogImage?: string;
}

const { title, description = SITE.description, current, ogImage = "/og.jpg" } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name}: free monster yard battles in your browser`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImageUrl = new URL(ogImage, SITE.url).href;

const nav = [
  { href: "/guides/", label: "Guides", id: "guides" },
  { href: "/changelog/", label: "Changelog", id: "changelog" },
  { href: "/support/", label: "Support us", id: "support" },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0f141c" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/titan-one/titan-one-latin.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Backyard Monsters Revamped: four painted wild monster tribe leaders under the game's title" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? SITE.name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="brand" href="/" aria-label={`${SITE.name}, home`}>
          <svg class="brand__mark" viewBox="0 0 32 32" aria-hidden="true">
            <path d="M10 3h12l6 13-6 13H10L4 16z" fill="#f0a12e"></path>
            <path d="M12 9h8l3.5 7-3.5 7h-8L8.5 16z" fill="#0f141c" opacity=".22"></path>
          </svg>
          <span class="brand__words">
            <span class="brand__top">Backyard Monsters</span>
            <span class="brand__bottom">Revamped</span>
          </span>
        </a>

        <nav class="site-nav" aria-label="Main">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={current === item.id ? "page" : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>

        <a class="btn btn--primary site-header__play" href={SITE.gameUrl}>Play free</a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="site-footer__top">
          <div class="site-footer__brand">
            <p class="site-footer__name">Backyard Monsters Revamped</p>
            <p class="site-footer__tag">Free to play in your browser. Open beta.</p>
          </div>
          <nav class="site-footer__links" aria-label="Footer">
            <a href={SITE.gameUrl}>Play</a>
            <a href="/guides/">Guides</a>
            <a href="/changelog/">Changelog</a>
            <a href="/support/">Support</a>
            <a href="/credits/">Credits</a>
            <a href={SITE.privacyUrl}>Privacy</a>
            <a href={SITE.termsUrl}>Terms</a>
            {SITE.discordUrl && <a href={SITE.discordUrl} rel="noopener noreferrer">Discord</a>}
          </nav>
        </div>
        <p class="site-footer__legal">
          Unofficial fan project. Not made by Kixeye, and not affiliated with, endorsed by or sponsored by Kixeye.
          "Backyard Monsters" and related names, logos and artwork belong to Kixeye or their respective owners.
          Server based on
          <a href={SITE.refittedUrl} rel="noopener noreferrer">Backyard Monsters Refitted</a>.
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(15 20 28 / 86%);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 12px 24px;
    min-height: 68px;
    flex-wrap: wrap;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--text-strong);
    margin-right: auto;
  }

  .brand__mark {
    width: 36px;
    height: 36px;
    flex: none;
    filter: drop-shadow(0 3px 0 #a8630b);
  }

  .brand__words {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    line-height: 1;
  }

  .brand__top {
    font-size: 1.05rem;
  }

  .brand__bottom {
    font-size: 0.8rem;
    color: var(--accent);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-top: 3px;
  }

  .site-nav {
    display: flex;
    gap: 4px;
  }

  .site-nav a {
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    color: var(--text-secondary);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1rem;
  }

  .site-nav a:hover {
    color: var(--text-strong);
    background: var(--wash);
  }

  .site-nav a[aria-current="page"] {
    color: var(--text-strong);
    background: var(--accent-soft);
    box-shadow: inset 0 0 0 1px var(--accent-line);
  }

  .site-header__play {
    min-height: 42px;
    padding: 10px 20px;
    font-size: 1rem;
    box-shadow: 0 4px 0 var(--accent-pressed);
  }

  @media (max-width: 760px) {
    .site-header__inner {
      padding-top: 10px;
      padding-bottom: 0;
      gap: 8px 12px;
    }

    .site-nav {
      order: 3;
      width: 100%;
      justify-content: space-between;
      border-top: 1px solid var(--border-subtle, rgb(255 255 255 / 6%));
      padding: 4px 0 6px;
    }

    .site-nav a {
      padding: 8px 10px;
      font-size: 0.95rem;
    }

    .brand__mark {
      width: 30px;
      height: 30px;
    }

    .brand__top {
      font-size: 0.95rem;
    }

    .brand__bottom {
      font-size: 0.72rem;
    }

    .site-header__play {
      min-height: 38px;
      padding: 8px 16px;
      font-size: 0.95rem;
    }
  }

  .site-footer {
    margin-top: auto;
    background: var(--bg-deep);
    border-top: 1px solid var(--border);
    padding: 40px 0 36px;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .site-footer__top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 20px 40px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 20px;
  }

  .site-footer__name {
    font-family: var(--font-display);
    color: var(--text-strong);
    font-size: 1.15rem;
    margin: 0 0 4px;
  }

  .site-footer__tag {
    margin: 0;
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    align-items: center;
  }

  .site-footer__links a {
    color: var(--text-secondary);
    text-decoration: none;
    padding: 6px 0;
  }

  .site-footer__links a:hover {
    color: var(--text-strong);
    text-decoration: underline;
  }

  .site-footer__legal {
    margin: 0;
    max-width: 820px;
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .site-footer__legal a {
    color: var(--text-secondary);
  }
</style>
