---
import Base from "../layouts/Base.astro";
import { SITE } from "../config";
---

<Base title="Page not found" description="This page does not exist." noindex>
  <div class="wrap lost">
    <img src="/images/bob-worried.webp" alt="Bob, looking worried" width="240" height="240" />
    <h1>Nothing in this yard</h1>
    <p>We couldn't find that page. It may have moved, or the link may be wrong.</p>
    <div class="btn-row">
      <a class="btn btn--primary" href={SITE.gameUrl}>Play the game</a>
      <a class="btn btn--ghost" href="/">Go to the home page</a>
    </div>
  </div>
</Base>

<style>
  .lost {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: 64px;
    padding-bottom: 96px;
  }

  .lost img {
    width: 200px;
    margin-bottom: 12px;
  }

  .lost p {
    color: var(--text-secondary);
    margin-bottom: 28px;
  }

  .lost .btn-row {
    justify-content: center;
  }
</style>
