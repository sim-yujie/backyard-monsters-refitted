    left: 0;
    right: 0;
    bottom: 10px;
    height: 100px;
    z-index: 3;
    pointer-events: none;
  }

  /* Full width, so translateX(100%) is the width of the hero. */
  .marcher {
    position: absolute;
    left: 0;
    width: 100%;
    bottom: var(--y);
    transform: translateX(var(--rest));
    animation: march var(--cross) linear var(--delay) infinite;
    filter: drop-shadow(0 3px 2px rgb(0 0 0 / 30%));
  }

  @keyframes march {
