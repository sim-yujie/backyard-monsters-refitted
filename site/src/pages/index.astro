  /* The three lines bounce up one after another; they start in view, just lower. */
  .hero__line {
    display: block;
    white-space: nowrap;
    transform-origin: 0 100%;
    animation: line-in 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) calc(0.08s + var(--n) * 0.14s) both;
  }

  @keyframes line-in {
    from {
      transform: translateY(0.45em) scale(0.92) rotate(-2deg);
    }
    to {
      transform: none;
    }
  }

  .hero__accent {
    color: var(--accent);
    background: linear-gradient(100deg, var(--accent) 0%, var(--accent) 40%, #d9fbff 50%, var(--accent) 60%, var(--accent) 100%)
      0 0 / 250% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    /* A text-shadow would show through the clipped text; a drop shadow does not. */
    text-shadow: none;
    filter: drop-shadow(0 4px 0 rgb(0 0 0 / 35%));
    animation:
      line-in 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) calc(0.08s + var(--n) * 0.14s) both,
      shimmer 5s ease-in-out 1.6s infinite;
  }

  @keyframes shimmer {
