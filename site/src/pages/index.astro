---
import Base from "../layouts/Base.astro";
import Shot from "../components/Shot.astro";
import Sprite from "../components/Sprite.astro";
import { SITE } from "../config";
import { getCollection } from "astro:content";
import { faq } from "../data/faq";
import { faqPage, raidVideo, videoGame } from "../data/schema";
import { tiers } from "../data/patreon";

const changelog = (await getCollection("changelog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const latest = changelog.slice(0, 2);
// The beta.4 changelog entry, for the "full list" link in its section.
const beta4Log = changelog.find((entry) => entry.id.includes("beta-4"));

const fmt = new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });

const features = [
  {
    title: "Build your yard",
    text: "Harvesters gather twigs, pebbles, putty and goo. Spend them on new buildings and upgrades, and grow your Town Hall to unlock more.",
    img: "/images/monsters/C12.webp",
    alt: "D.A.V.E., a rusty robot monster",
  },
  {
    title: "Hatch an army",
    text: "Unlock new kinds of monster in the Locker, hatch them from goo, and train them up in the Monster Academy.",
    img: "/images/monsters/C1.webp",
    alt: "Pokey, a round pink monster covered in spikes",
  },
  {
    title: "Defend what's yours",
    text: "Towers, walls and traps guard your yard. Test your defences against an army of your own choosing with the Wild Monster Baiter.",
    img: "/images/monsters/C8.webp",
    alt: "Fang, a red spider-legged monster",
  },
  {
    title: "Raid your rivals",
    text: "Fling your monsters into wild tribe camps and other players' yards from the Map Room, and bring home their loot.",
    img: "/images/monsters/C7.webp",
    alt: "Bandito, a green clawed monster",
  },
];

// "What's new in Revamped": what is different from the original game. Every
// picture is from the game itself; `img` names a pair in
// public/images/whatsnew/ (<name>.webp at 768 px wide, <name>-384.webp).
const whatsNew = [
  {
    title: "No Flash. No download.",
    text: "Plays in any modern browser tab, on a game rebuilt from scratch.",
    img: "yard",
    alt: "A busy yard in the game, open in a browser tab",
  },
  {
    title: "Monsters, repainted.",
    text: "Your favourite monsters redrawn in high detail, some with brand-new animations.",
    alt: "The repainted Teratorn, a winged monster breathing fire",
  },
  {
    title: "Less clicking, more raiding.",
    text: "Hatch a whole army in one click, collect everything at once, and see exact numbers and timers at a glance. Speed battles up to 2x.",
    img: "hatch",
    alt: "The Hatchery screen: 40 Pokeys added in one go, spread across five Hatcheries",
  },
  {
    title: "A friendly start.",
    text: "Bob walks you through your first yard, first defence and first raid in about 8 minutes.",
    img: "bob",
    alt: "Bob, a green monster, explaining the next step of the guided start",
  },
  {
    title: "New ways to play.",
    text: "Fog of war in the Map Room (not in the original), auto-attack wild camps, set each champion to attack, defend or both, and plan your perfect layout in the Yard Planner.",
    img: "fog",
    alt: "The Map Room, with unexplored cells hidden under fog at the edge",
    badge: "New: not in the original",
  },
  {
    title: "Free and fair.",
    text: "Free to play, with no store: Shiny is earned in the game. Patreon is optional and gives no in-game advantage. The server checks every attack, so cheaters have a harder time.",
    img: "raid",
    alt: "Monsters raiding a walled yard",
  },
];

// "New in beta.4". Pictures are the painted What's new cards from the game
// (web/public/whats-new/beta4-*.webp); `img` names a pair in
// public/images/beta4/ (<name>.webp at 768 x 432, <name>-384.webp).
const halloweenPrizes = [
  ["10 pumpkins", "10 Shiny"],
  ["25 pumpkins", "25,000 of each resource"],
  ["50 pumpkins", "2 Mini-Pumpkins and 20 Shiny"],
  ["100 pumpkins", "a D.A.V.E. Pumpkin and 30 Shiny"],
];

const beta4 = [
  {
    title: "Events and daily treats",
    text: "The new Events button shows what's on now and what's coming next. Log in each day of Halloween for 14 days of treats, free speed-ups included.",
    img: "events",
    alt: "Bob opening a wooden advent calendar full of treats",
    badge: "14 days",
  },
  {
    title: "Champions hatch from eggs",
    text: "Raising a champion now gives you a special egg. One day later, out pops your new champion. Changed your mind? Cancel the egg and pick again.",
    img: "champion-eggs",
    alt: "A furry blue champion egg cracking open in a straw nest",
  },
  {
    title: "Friends list upgrade",
    text: "Find friends fast with search and filters, and see at a glance who you can help or send a gift to.",
    img: "friends",
    alt: "Two cheerful Pokeys high-fiving, one holding a gift",
  },
  {
    title: "Tidier on phones",
    text: "One Menu button holds everything, friends tuck away behind their own button, and the battle screen stays clear.",
    img: "phone",
    alt: "A Pokey sweeping up buttons beside a phone showing a yard",
  },
  {
    title: "Special moves tuned",
    text: "Bandito's whirlwind spins through enemy monsters, Teratorn's fireball bounces on to walls, and defending Bolts blink too. Fang's venom bites once a second again.",
    img: "special-moves",
    alt: "A Bandito spinning a green whirlwind while a Teratorn breathes fire at a fence",
  },
  {
    title: "Monsters on the move",
    text: "Crabatron scuttles, Fang creeps, Eye-ra slithers, and lots more: 15 monsters now walk and attack with brand-new animations.",
    img: "animations",
    alt: "Eye-ra, Fang and Crabatron racing across the grass",
    badge: "15 monsters",
  },
];

const beta4More = [
  "Map Room 1 shows online players with a green dot.",
  "Battles on Map Room 1 show as a shield (they attacked you) and a sword (you attacked them).",
  "Map Room 1 remembers how you sorted the list, with a highest/lowest-first button.",
  "On Map Room 2 on phones, Mail, My range and Filter sit beside \"Find a place\".",
  "What's new cards like these pop up in the game after an update.",
  "A new Thank-you page on this website for everyone who supports the game.",
];

const roster = [
  ["C1", "Pokey"],
  ["C2", "Octo-ooze"],
  ["C3", "Bolt"],
  ["C4", "Fink"],
  ["C5", "Eye-ra"],
  ["C7", "Bandito"],
  ["C8", "Fang"],
  ["C9", "Brain"],
  ["C10", "Crabatron"],
  ["C14", "Teratorn"],
  ["C15", "Zafreeti"],
  ["C16", "Vorg"],
] as const;

// The FAQ answers are plain text; the game's address and the bug email in
// them become links.
const gameHost = new URL(SITE.gameUrl).host;
const linkable = new RegExp(`(${[gameHost, SITE.bugEmail].map((t) => t.replace(/[.]/g, "\\.")).join("|")})`);
const answerParts = (text: string) =>
  text.split(linkable).map((part) => ({
    text: part,
    href: part === gameHost ? SITE.gameUrl : part === SITE.bugEmail ? `mailto:${SITE.bugEmail}` : undefined,
  }));

const schema = [videoGame, ...(SITE.showcaseVideo.src ? [raidVideo] : []), faqPage(faq)];

// The four tribe leaders in the hero. Each sits at its own depth for the
// mouse parallax and pops in at its own moment.
const leaders = [
  { id: "kozu", w: 489, h: 560, depth: 10, delay: 0.35 },
  { id: "dreadnaut", w: 540, h: 560, depth: 22, delay: 0.55 },
  { id: "abunakki", w: 515, h: 560, depth: 18, delay: 0.7 },
  { id: "legionnaire", w: 560, h: 464, depth: 34, delay: 0.85 },
];

// Real game sprites crossing the bottom of the hero. `rest` is where each one
// stands when motion is switched off; `delay` is negative so the parade is
// already under way when the page opens.
const parade = [
  { name: "walk-C1", height: 58, step: 0.42, cross: 15, delay: -2, rest: "6%", y: 10 },
  { name: "walk-C1", height: 52, step: 0.42, cross: 15, delay: -3.2, rest: "12%", y: 2 },
  { name: "walk-C7", height: 78, step: 0.75, cross: 28, delay: -16, rest: "44%", y: 6 },
  { name: "walk-C2", height: 70, step: 0.9, cross: 36, delay: -26, rest: "70%", y: 4 },
  { name: "walk-C1", height: 54, step: 0.42, cross: 15, delay: -10, rest: "88%", y: 12 },
] as const;

// The grass fringe along the bottom of the hero: one blade every 12 units of
// a 1440-wide strip, heights from a fixed pattern.
const grass =
  "M0 40V26" +
  Array.from({ length: 120 }, (_, i) => `L${i * 12 + 6} ${8 + ((i * 7) % 11)}L${i * 12 + 12} ${24 + ((i * 5) % 6)}`).join("") +
  "V40Z";

// Glowing goo motes drifting up through the hero, placed by a fixed pattern
// so every build is the same.
const motes = Array.from({ length: 18 }, (_, i) => ({
  x: (i * 37 + 11) % 100,
  size: 4 + ((i * 7) % 6),
  time: 9 + ((i * 5) % 8),
  delay: -((i * 13) % 17),
  hue: ["cyan", "lime", "amber"][i % 3],
}));
---

<Base current="home" schema={schema}>
  <section class="hero" data-parallax>
    <div class="hero__motes" aria-hidden="true">
      {
        motes.map((m) => (
          <span
            class={`mote mote--${m.hue}`}
            style={`--x:${m.x}%;--size:${m.size}px;--time:${m.time}s;--delay:${m.delay}s`}
          />
        ))
      }
    </div>

    <svg class="hero__hills hero__hills--far depth" style="--depth:6px" viewBox="0 0 1440 220" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 120C180 60 330 70 480 110S800 170 980 120 1300 40 1440 90V220H0Z" fill="#132a1c"></path>
    </svg>
    <svg class="hero__hills hero__hills--near depth" style="--depth:12px" viewBox="0 0 1440 160" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 80C220 30 420 40 640 76S1050 120 1240 70 1400 40 1440 50V160H0Z" fill="#1a3a22"></path>
    </svg>

    <div class="wrap hero__inner">
      <div class="hero__copy">
        <span class="pill pill--beta hero__pill"><span class="live-dot" aria-hidden="true"></span>Open beta</span>
        <h1>
          <span class="hero__line" style="--n:0">Your backyard.</span>
          <span class="hero__line hero__accent" style="--n:1">Your monsters.</span>
          <span class="hero__line" style="--n:2">Their loot.</span>
        </h1>
        <p class="hero__lead">
          Backyard Monsters Revamped is a free, fan-made revamp of Backyard Monsters. Build a yard, hatch an army of
          monsters and raid wild tribes and other players, right in your browser. No Flash, no download.
        </p>
        <div class="btn-row hero__buttons">
          <a class="btn btn--primary btn--big btn--glow" href={SITE.gameUrl}>Play free now</a>
          <a class="btn btn--ghost" href="/guides/getting-started/">How to start</a>
        </div>
        <p class="hero__small">Sign up with a username, email and password. Free to play, nothing to install.</p>
        <a class="hero__trailer" href="#trailer" hidden>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
            <circle cx="12" cy="12" r="11" fill="currentColor"></circle>
            <path d="M10 8v8l6-4Z" fill="#0f141c"></path>
          </svg>
          Watch the beta 3 trailer
        </a>
      </div>

      <div class="hero__art" aria-hidden="true">
        <div class="hero__glow depth" style="--depth:4px"></div>
        <div class="hero__ground depth" style="--depth:14px"></div>
        {
          leaders.map((l) => (
            <div class={`leader leader--${l.id} depth`} style={`--depth:${l.depth}px;--delay:${l.delay}s`}>
              <img src={`/images/tribes/${l.id}.webp`} alt="" width={l.w} height={l.h} fetchpriority={l.id === "kozu" ? "high" : undefined} />
            </div>
          ))
        }
        <span class="flyer depth" style="--depth:40px">
          <Sprite name="walk-C14" height={64} duration={0.36} eager />
        </span>
      </div>
    </div>

    <div class="parade" aria-hidden="true">
      {
        parade.map((p) => (
          <span class="marcher" style={`--cross:${p.cross}s;--delay:${p.delay}s;--rest:${p.rest};--y:${p.y}px`}>
            <Sprite name={p.name} height={p.height} duration={p.step} eager />
          </span>
        ))
      }
    </div>
    <svg class="hero__grass" viewBox="0 0 1440 40" preserveAspectRatio="none" aria-hidden="true">
      <path d={grass} fill="#1f4527"></path>
    </svg>
  </section>

  <section id="trailer" class="trailer" aria-label="Trailer">
    <div class="wrap">
      <figure class="trailer__frame">
        <img
          class="trailer__poster"
          src={SITE.trailer.poster}
          alt="A big attack on a walled yard: monsters storm the housing as towers fire back"
          width="1280"
          height="720"
          decoding="async"
        />
        {
          SITE.trailer.src && (
            <video
              class="trailer__video"
              data-src={SITE.trailer.src}
              width="1280"
              height="720"
              muted
              loop
              playsinline
              preload="none"
              aria-label="Backyard Monsters Revamped trailer"
            />
          )
        }
        <button class="trailer__sound btn btn--primary" type="button" hidden>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path d="M4 9v6h4l5 4V5L8 9H4Z" fill="currentColor"></path>
            <path d="M16 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"></path>
          </svg>
          <span class="trailer__label">Play with sound</span>
        </button>
      </figure>
    </div>
  </section>

  <section class="beta" aria-labelledby="beta-title">
    <div class="wrap">
      <div class="notice beta__notice reveal">
        <svg class="beta__icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 2 1 21h22L12 2Z" fill="#f5b94a"></path>
          <path d="M11 9h2v6h-2zM11 17h2v2h-2z" fill="#2a1a00"></path>
        </svg>
        <div>
          <h2 id="beta-title" class="beta__title">This is an open beta</h2>
          <p>
            The game is live and free to play, but it is still being built. Things may break, and
            <strong>your progress may be reset</strong> before the full launch. Play for fun, and tell us what you find at
            <a href={`mailto:${SITE.bugEmail}`}>{SITE.bugEmail}</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="beta-4" class="section beta4" aria-labelledby="beta4-title">
    <div class="wrap">
      <div class="section__head reveal">
        <span class="eyebrow">Update 2.0.0-beta.4</span>
        <h2 id="beta4-title">New in beta 4</h2>
        <p>Halloween comes to the backyard, with a pumpkin hunt, daily treats and champions that hatch from eggs.</p>
      </div>
      <div class="beta4__grid">
        <article class="spotlight reveal reveal--pop">
          <div class="spotlight__art">
            <img
              src="/images/beta4/halloween.webp"
              srcset="/images/beta4/halloween-384.webp 384w, /images/beta4/halloween.webp 768w"
              sizes="(max-width: 760px) 100vw, 560px"
              alt="Bob in a witch's hat beside a glowing jack-o'-lantern on a moonlit night"
              width="768"
              height="432"
              loading="lazy"
              decoding="async"
            />
            <span class="pill pill--beta change__badge">From 28 Oct</span>
          </div>
          <div class="spotlight__body">
            <h3>Halloween is here!</h3>
            <p>
              From 28 October your yard goes spooky for two whole weeks, with pumpkins where the mushrooms used to grow.
              Tap a pumpkin to send a worker to pick it, and collect enough for prizes:
            </p>
            <ul class="spotlight__list">
              {
                halloweenPrizes.map(([need, prize]) => (
                  <li>
                    <strong>{need}:</strong> {prize}
                  </li>
                ))
              }
            </ul>
          </div>
        </article>
        {
          beta4.map((b, i) => (
            <article class="change reveal reveal--pop" style={`--i:${i % 3}`}>
              <div class="change__art change__art--wide">
                <img
                  src={`/images/beta4/${b.img}.webp`}
                  srcset={`/images/beta4/${b.img}-384.webp 384w, /images/beta4/${b.img}.webp 768w`}
                  sizes="(max-width: 560px) 100vw, (max-width: 1020px) 50vw, 380px"
                  alt={b.alt}
                  width="768"
                  height="432"
                  loading="lazy"
                  decoding="async"
                />
                {b.badge && <span class="pill pill--beta change__badge">{b.badge}</span>}
              </div>
              <div class="change__body">
                <h3>{b.title}</h3>
                <p>{b.text}</p>
              </div>
            </article>
          ))
        }
        <div class="beta4__more reveal" style="--i:1">
          <h3>Also in this update</h3>
          <ul>
            {beta4More.map((item) => <li>{item}</li>)}
          </ul>
          {beta4Log && <a href={`/changelog/#${beta4Log.id}`}>See every change in beta 4</a>}
        </div>
      </div>
    </div>
  </section>

  <section class="section whatsnew" aria-labelledby="whatsnew-title">
    <div class="wrap">
      <div class="section__head reveal">
        <span class="eyebrow">What's different</span>
        <h2 id="whatsnew-title">What's new in Revamped</h2>
        <p>The game you remember, with some big changes from the original Backyard Monsters.</p>
      </div>
      <ul class="whatsnew__list">
        {
          whatsNew.map((w, i) => (
            <li class="change reveal reveal--pop" style={`--i:${i % 3}`}>
              <div class={`change__art${w.img === "yard" ? " change__art--browser" : ""}`}>
                {w.img === "yard" && (
                  <div class="change__tab" aria-hidden="true">
                    <span class="change__dots">
                      <i />
                      <i />
                      <i />
                    </span>
                    <span class="change__url">{gameHost}</span>
                  </div>
                )}
                {w.img ? (
                  <img
                    src={`/images/whatsnew/${w.img}.webp`}
                    srcset={`/images/whatsnew/${w.img}-384.webp 384w, /images/whatsnew/${w.img}.webp 768w`}
                    sizes="(max-width: 560px) 100vw, (max-width: 1020px) 50vw, 380px"
                    alt={w.alt}
                    width="768"
                    height="512"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <>
                    <img src="/images/monsters/C14.webp" alt={w.alt} width="360" height="240" loading="lazy" />
                    <span class="change__walker">
                      <Sprite name="walk-C1" height={72} duration={0.42} />
                    </span>
                  </>
                )}
                {w.badge && <span class="pill pill--beta change__badge">{w.badge}</span>}
              </div>
              <div class="change__body">
                <span class="change__num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                <h3>{w.title}</h3>
                <p>{w.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="features-title">
    <div class="wrap">
      <div class="section__head reveal">
        <span class="eyebrow">How it plays</span>
        <h2 id="features-title">Build, hatch, defend, raid</h2>
        <p>The yard-building monster battler you remember, rebuilt to run in a modern browser.</p>
      </div>
      <ul class="features">
        {
          features.map((f, i) => (
            <li class="feature reveal reveal--pop" style={`--i:${i}`}>
              <div class="feature__art">
                <img src={f.img} alt={f.alt} width="360" height="240" loading="lazy" />
              </div>
              <div class="feature__body">
                <h3>{f.title}</h3>
                <p>{f.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section bob" aria-labelledby="bob-title">
    <div class="wrap bob__inner">
      <div class="bob__art reveal reveal--pop">
        <div class="bubble">
          "Welcome to Backyard Monsters! I'm Bob. Give me eight minutes and I'll have your yard ready for anything."
        </div>
        <img src="/images/bob.webp" alt="Bob, a friendly green monster, pointing" width="240" height="240" loading="lazy" />
      </div>
      <div class="bob__copy reveal" style="--i:1">
        <span class="eyebrow">New here?</span>
        <h2 id="bob-title">Bob shows you the ropes</h2>
        <p>
          New players get a guided start with Bob. In a few minutes you build your first defences, watch a wild tribe
          attack, get a squad of free Pokeys and lead your first raid.
        </p>
        <p>When Bob is done, your yard is protected from other players for 7 days while you find your feet.</p>
        <a class="btn btn--ghost" href="/guides/getting-started/">Read the starter guide</a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="shots-title">
    <div class="wrap">
      <div class="section__head reveal">
        <span class="eyebrow">In the game</span>
        <h2 id="shots-title">See it in action</h2>
        <p>Teratorns tear into a Kozu Tribe camp. Every raid plays out live, right in your browser.</p>
      </div>
      <figure class="showcase reveal">
        <div class="showcase__frame">
          <video
            class="showcase__video"
            data-src={SITE.showcaseVideo.src || undefined}
            poster={SITE.showcaseVideo.poster}
            width="1280"
            height="720"
            muted
            loop
            playsinline
            preload="none"
            aria-label="Gameplay: Teratorns raiding a wild tribe camp"
          ></video>
          <span class="showcase__badge" aria-hidden="true"><span class="live-dot"></span>Raid in progress</span>
        </div>
      </figure>
      <div class="shots">
        <div class="reveal" style="--i:0"><Shot name="yard" caption="Your yard: Town Hall walled in the middle, towers all round" sizes="(max-width: 860px) 100vw, 380px" /></div>
        <div class="reveal" style="--i:1"><Shot name="raid-yard" caption="Teratorns and Korath storming an enemy yard" sizes="(max-width: 860px) 100vw, 380px" /></div>
        <div class="reveal" style="--i:2"><Shot name="map" caption="The Map Room" sizes="(max-width: 860px) 100vw, 380px" /></div>
      </div>
    </div>
  </section>

  <section class="section roster" aria-labelledby="roster-title">
    <div class="wrap">
      <div class="section__head reveal">
        <span class="eyebrow">Meet the monsters</span>
        <h2 id="roster-title">Start with Pokeys. Unlock the rest.</h2>
        <p>Every monster has its own job in a raid. Mix them up to crack open any defence.</p>
      </div>
    </div>
    <ul class="roster__list">
      {
        roster.map(([id, name], i) => (
          <li class="roster__card reveal reveal--pop" style={`--i:${i % 6}`}>
            <div class="roster__art">
              <img class="roster__portrait" src={`/images/monsters/${id}.webp`} alt="" width="360" height="240" loading="lazy" />
              <Sprite name={`spin-${id}`} height={80} duration={1.5} class="roster__sprite" />
            </div>
            <span class="roster__name">{name}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section news" aria-labelledby="news-title">
    <div class="wrap news__inner">
      <div class="reveal">
