<script>
  const calm = window.matchMedia("(prefers-reduced-motion: reduce)");

  // Mouse parallax in the hero: each layer drifts by its own --depth.
  const hero = document.querySelector<HTMLElement>("[data-parallax]");
  if (hero && window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
    let frame = 0;
    let x = 0;
    let y = 0;
    hero.addEventListener("pointermove", (event) => {
      const box = hero.getBoundingClientRect();
      x = ((event.clientX - box.left) / box.width) * 2 - 1;
      y = ((event.clientY - box.top) / box.height) * 2 - 1;
      if (!frame && !calm.matches) {
        frame = requestAnimationFrame(() => {
          hero.style.setProperty("--px", x.toFixed(3));
          hero.style.setProperty("--py", y.toFixed(3));
          frame = 0;
        });
      }
    });
    hero.addEventListener("pointerleave", () => {
      hero.style.setProperty("--px", "0");
      hero.style.setProperty("--py", "0");
    });
  }

  // The trailer under the hero. It starts loading only once the page itself
  // has finished loading, plays muted on a loop, and offers "Play with
  // sound". With reduced motion or data saver it does not play by itself; the
  // button then reads "Play trailer". If the file is missing or fails, the
  // poster still simply stays and no button or hero link ever appears.
  const trailerFrame = document.querySelector<HTMLElement>(".trailer__frame");
  const trailer = trailerFrame?.querySelector<HTMLVideoElement>(".trailer__video");
  const trailerSrc = trailer?.dataset.src;
  if (trailerFrame && trailer && trailerSrc) {
    const button = trailerFrame.querySelector<HTMLButtonElement>(".trailer__sound")!;
    const label = button.querySelector<HTMLElement>(".trailer__label")!;
    const heroLink = document.querySelector<HTMLElement>(".hero__trailer");
    const still = calm.matches || Boolean((navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData);
    let failed = false;

    const ready = () => {
      if (failed) return;
      button.hidden = false;
      if (heroLink) heroLink.hidden = false;
    };
    trailer.addEventListener("error", () => {
      failed = true;
      button.hidden = true;
      if (heroLink) heroLink.hidden = true;
      trailerFrame.classList.remove("is-playing");
    });
    trailer.addEventListener("playing", () => trailerFrame.classList.add("is-playing"));
    trailer.addEventListener(still ? "loadedmetadata" : "playing", ready, { once: true });

    button.addEventListener("click", () => {
      trailer.muted = false;
      trailer.loop = false;
      trailer.currentTime = 0;
      trailer.controls = true;
      button.hidden = true;
      trailer.play().catch(() => {});
    });

    const start = () => {
      if (still) {
        label.textContent = "Play trailer";
        trailer.preload = "metadata";
        trailer.src = trailerSrc;
        return;
      }
      const watcher = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              if (!trailer.src) trailer.src = trailerSrc;
              if (!failed) trailer.play().catch(() => ready());
            } else if (trailer.src && trailer.muted) {
              trailer.pause();
            }
          }
        },
        { rootMargin: "200px 0px" },
      );
      watcher.observe(trailerFrame);
    };
    const whenIdle = () => ("requestIdleCallback" in window ? requestIdleCallback(start, { timeout: 2000 }) : setTimeout(start, 300));
    if (document.readyState === "complete") whenIdle();
    else window.addEventListener("load", whenIdle, { once: true });
  }

  // The gameplay clip loads only when it is about to scroll into view. With
  // reduced motion it does not play by itself; it gets controls instead.
  const video = document.querySelector<HTMLVideoElement>(".showcase__video");
  const source = video?.dataset.src;
  if (video && source) {
    if (calm.matches) {
      video.controls = true;
      video.src = source;
    } else if ("IntersectionObserver" in window) {
      const watcher = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              if (!video.src) video.src = source;
              video.play().catch(() => {
                video.controls = true;
              });
            } else if (video.src) {
              video.pause();
            }
          }
        },
        { rootMargin: "200px 0px" },
      );
      watcher.observe(video);
    } else {
      video.controls = true;
      video.src = source;
    }
  }
</script>

<style>
  /* ── Hero ────────────────────────────────────────────────────────────── */

  .hero {
    --px: 0;
    --py: 0;
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(900px 500px at 78% 40%, rgb(61 214 245 / 16%), transparent 65%),
      radial-gradient(700px 400px at 10% 110%, rgb(111 191 74 / 14%), transparent 70%),
      linear-gradient(180deg, #0a0e14 0%, #0f141c 70%, #10201a 100%);
    border-bottom: 1px solid var(--border);
  }

  /* Each layer drifts against the mouse by its own depth (set by the script). */
  .depth {
    translate: calc(var(--px) * var(--depth) * -1) calc(var(--py) * var(--depth) * -1);
    transition: translate 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    align-items: center;
    gap: 32px;
    min-height: min(760px, calc(100vh - 68px));
    padding-top: 48px;
    padding-bottom: 136px;
  }

  .hero__pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 0 0 currentColor;
    animation: live-ping 1.8s ease-out infinite;
  }

  @keyframes live-ping {
    0% {
      box-shadow: 0 0 0 0 rgb(255 255 255 / 55%);
    }
    100% {
      box-shadow: 0 0 0 9px rgb(255 255 255 / 0%);
    }
  }

  .hero__copy h1 {
    margin-top: 18px;
    font-size: clamp(2.4rem, 5vw, 4rem);
    line-height: 1.05;
    text-shadow: 0 4px 0 rgb(0 0 0 / 35%);
